{
  "name": "Client",
  "type": "object",
  "properties": {
    "gym_id": {
      "type": "string",
      "title": "Gimnasio ID"
    },
    "name": {
      "type": "string",
      "title": "Nombre"
    },
    "rut": {
      "type": "string",
      "title": "RUT"
    },
    "phone": {
      "type": "string",
      "title": "Tel\u00e9fono"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "photo_url": {
      "type": "string",
      "title": "Foto URL"
    },
    "notes": {
      "type": "string",
      "title": "Notas"
    },
    "preferred_payment_method": {
      "type": "string",
      "title": "M\u00e9todo de Pago Preferido",
      "enum": [
        "efectivo",
        "transferencia",
        "tarjeta_debito",
        "tarjeta_credito",
        "no_especificado"
      ],
      "default": "no_especificado"
    },
    "active": {
      "type": "boolean",
      "title": "Activo",
      "default": true
    }
  },
  "required": [
    "name",
    "gym_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}