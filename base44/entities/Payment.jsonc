{
  "name": "Payment",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "title": "Cliente ID"
    },
    "client_name": {
      "type": "string",
      "title": "Nombre Cliente"
    },
    "gym_id": {
      "type": "string",
      "title": "Gimnasio ID"
    },
    "plan_id": {
      "type": "string",
      "title": "Plan ID"
    },
    "plan_name": {
      "type": "string",
      "title": "Nombre Plan"
    },
    "amount": {
      "type": "number",
      "title": "Monto"
    },
    "date": {
      "type": "string",
      "title": "Fecha Pago"
    },
    "start_date": {
      "type": "string",
      "title": "Fecha Inicio Membres\u00eda"
    },
    "use_date": {
      "type": "string",
      "title": "Fecha de Uso (Pase Libre)"
    },
    "payment_method": {
      "type": "string",
      "title": "M\u00e9todo de Pago",
      "enum": [
        "Efectivo",
        "Transferencia",
        "Tarjeta de D\u00e9bito",
        "Tarjeta de Cr\u00e9dito"
      ],
      "default": "Efectivo"
    },
    "confirmed": {
      "type": "boolean",
      "title": "Confirmado",
      "default": false
    },
    "confirmed_date": {
      "type": "string",
      "title": "Fecha Confirmaci\u00f3n"
    },
    "notes": {
      "type": "string",
      "title": "Notas"
    }
  },
  "required": [
    "client_id",
    "gym_id",
    "amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}